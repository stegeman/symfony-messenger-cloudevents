{
    "name": "stegeman/symfony-messenger-cloud-events",
    "description": "Symfony Messenger Cloud Events",
    "type": "bundle",
    "license": "MIT",
    "version": "1.1.6",
    "authors": [
        {
            "name": "Rene Terstegen",
            "email": "rene@reneterstegen.eu"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "symfony/messenger": "^7.3 || ^8",
        "cloudevents/sdk-php": "^1.1",
        "ramsey/uuid": "^4.9",
        "symfony/http-kernel": "^7.3 || ^8",
        "symfony/config": "^7.3 || ^8",
        "symfony/dependency-injection": "^7.3 || ^8",
        "jms/serializer-bundle": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "matthiasnoback/symfony-config-test": "^6.1"
    },
    "autoload": {
        "psr-4": {
            "Stegeman\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stegeman\\Tests\\": "tests/"
        }
    }
}
