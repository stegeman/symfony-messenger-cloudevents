<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Default behaviour for all services -->
        <defaults autowire="true" autoconfigure="true"/>

        <!-- Concrete services (no extra configuration) -->
        <service id="Stegeman\Messenger\CloudEvents\Serializer\CloudEventsSerializer"/>
        <service id="Stegeman\Messenger\CloudEvents\Factory\V1\CloudEventFactory"/>
        <service id="cloud_events.normalizer" class="%cloud_events.normalizer_service_id%"/>
        <service id="Ramsey\Uuid\UuidFactory"/>
        <service id="Stegeman\Messenger\CloudEvents\Serializer\UuidGenerator"/>
        <service id="Stegeman\Messenger\CloudEvents\Serializer\MessageRegistry"/>
        <service id="Stegeman\Messenger\CloudEvents\Converter\V1\EnvelopeConverter">
            <argument type="service" id="Stegeman\Messenger\CloudEvents\Serializer\MessageRegistryInterface"/>
            <argument type="service" id="Stegeman\Messenger\CloudEvents\Serializer\IdGeneratorInterface"/>
        </service>
        <service id="CloudEvents\Serializers\Normalizers\V1\Denormalizer"/>
        <service id="Stegeman\Messenger\CloudEvents\Normalizer\V1\Denormalizer"/>
        <service id="CloudEvents\Serializers\Normalizers\V1\Normalizer"/>

        <!-- Aliases (interface → concrete implementation) -->
        <service id="Stegeman\Messenger\CloudEvents\Factory\CloudEventFactoryInterface"
                 alias="Stegeman\Messenger\CloudEvents\Factory\V1\CloudEventFactory"/>

        <service id="Ramsey\Uuid\UuidFactoryInterface"
                 alias="Ramsey\Uuid\UuidFactory"/>

        <service id="Stegeman\Messenger\CloudEvents\Serializer\IdGeneratorInterface"
                 alias="Stegeman\Messenger\CloudEvents\Serializer\UuidGenerator"/>

        <service id="Stegeman\Messenger\CloudEvents\Normalizer\NormalizerInterface"
                 alias="cloud_events.normalizer"/>

        <service id="Stegeman\Messenger\CloudEvents\Serializer\MessageRegistryInterface"
                 alias="Stegeman\Messenger\CloudEvents\Serializer\MessageRegistry"/>

        <service id="Stegeman\Messenger\CloudEvents\Converter\EnvelopeConverterInterface"
                 alias="Stegeman\Messenger\CloudEvents\Converter\V1\EnvelopeConverter"/>

        <service id="CloudEvents\Serializers\Normalizers\V1\DenormalizerInterface"
                 alias="CloudEvents\Serializers\Normalizers\V1\Denormalizer"/>

        <service id="Stegeman\Messenger\CloudEvents\Normalizer\DenormalizerInterface"
                 alias="Stegeman\Messenger\CloudEvents\Normalizer\V1\Denormalizer"/>
    </services>
</container>